    "/search/keyword": {
      "get": {
        "tags": [
          "SEARCH"
        ],
        "summary": "Api Search Keyword",
        "description": "Perform high-speed keyword search using SQLite FTS5 with BM25 ranking and Porter stemming.\nIdeal for short queries, acronyms (e.g. ATSEP, AMC-20), and specific regulatory terms.\nOptionally uses local LLM to expand queries with synonyms and domain terms.",
        "operationId": "api_search_keyword_search_keyword_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Keywords, acronyms, or search terms to match",
              "title": "Query"
            },
            "description": "Keywords, acronyms, or search terms to match"
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Number of results to return",
              "default": 5,
              "title": "Top K"
            },
            "description": "Number of results to return"
          },
          {
            "name": "origin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Filter by 'all', 'eu', or 'easa'",
              "default": "all",
              "title": "Origin"
            },
            "description": "Filter by 'all', 'eu', or 'easa'"
          },
          {
            "name": "use_llm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Enable LLM keyword expansion (synonyms, acronyms)",
              "default": true,
              "title": "Use Llm"
            },
            "description": "Enable LLM keyword expansion (synonyms, acronyms)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KeywordSearchResponse"
                  },
                  "title": "Response Api Search Keyword Search Keyword Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
