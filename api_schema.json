  "paths": {
    "/search": {
      "get": {
        "tags": [
          "SEARCH"
        ],
        "summary": "Api Search",
        "operationId": "api_search_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The text to search for",
              "title": "Query"
            },
            "description": "The text to search for"
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Number of results to return",
              "default": 5,
              "title": "Top K"
            },
            "description": "Number of results to return"
          },
          {
            "name": "origin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Filter by 'all', 'eu', or 'easa'",
              "default": "all",
              "title": "Origin"
            },
            "description": "Filter by 'all', 'eu', or 'easa'"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SearchResponse"
                  },
                  "title": "Response Api Search Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
